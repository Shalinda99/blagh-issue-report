# ─── App ────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8090

# ─── Storage (vector DB + relational DB) ──────────────────────────────────────
DATA_DIR=./data
CHROMA_DIR=./data/chroma
SQLITE_PATH=./data/similarity.db

# ─── mock IFS assyst connector ────────────────────────────────────────────────
# assyst is the single source of truth: blagh-reported issues are mirrored here.
ASSYST_BASE_URL=http://localhost:8081
ASSYST_USERNAME=mock_user
ASSYST_PASSWORD=change_me
ASSYST_EVENT_TYPE=INCIDENT

# ─── Sync window ──────────────────────────────────────────────────────────────
SYNC_WINDOW_DAYS=7
FETCH_PAGE_SIZE=100

# ─── Embeddings ───────────────────────────────────────────────────────────────
# hashing  = offline, no download (default). sentence = sentence-transformers.
EMBEDDER=hashing
EMBEDDING_DIM=768
ST_MODEL_NAME=all-MiniLM-L6-v2

# ─── Similarity engine ────────────────────────────────────────────────────────
TOP_K=5
VECTOR_WEIGHT=0.7
RULE_WEIGHT=0.3
DUPLICATE_THRESHOLD=0.72
CANDIDATE_THRESHOLD=0.55

# ─── LLM comparison (OpenAI-compatible; Groq by default) ──────────────────────
# Powers the batch "judge" during sync AND on-demand LLM similarity in the UI.
LLM_ENABLED=true
LLM_PROVIDER=groq                 # groq | openai
LLM_JUDGE_THRESHOLD=0.6
LLM_TIMEOUT=40

# Groq (OpenAI-compatible) — get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b            # fast model: on-demand Compare Lab
GROQ_JUDGE_MODEL=openai/gpt-oss-120b     # larger model: duplicate detection judge

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS_STR=http://localhost:5173,http://localhost:3100,http://localhost:3000
