# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME="Blagh API"
APP_VERSION=1.0.0
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local standalone instance (default)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=blagh

# MongoDB Atlas (cloud) — uncomment and replace <user>, <password>, <cluster>
# MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=blagh

# ─── MinIO (Object Storage) ───────────────────────────────────────────────────
# Local MinIO instance (default) — see MINIO_GUIDE.md for setup instructions
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=blagh-reports
MINIO_PRESIGN_EXPIRES_HOURS=24

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the widget
ALLOWED_ORIGINS_STR=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# ─── Assyst mirroring ─────────────────────────────────────────────────────────
# Every blagh report is mirrored into assyst (the IT service desk) as an
# INCIDENT. In local dev this points at the mocked_assyst service.
ASSYST_MIRROR_ENABLED=true
ASSYST_BASE_URL=http://localhost:8081
ASSYST_USERNAME=mock_user
ASSYST_PASSWORD=change_me
ASSYST_EVENT_TYPE=INCIDENT
ASSYST_TIMEOUT_SECONDS=15

# Base URL of the admin UI — used to build the deep link embedded in the assyst
# incident remarks so staff can open the full diagnostics for the report.
ADMIN_UI_BASE_URL=http://localhost:5175

# ─── Admin JWT ────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ─── Admin bootstrap credentials ──────────────────────────────────────────────
INITIAL_ADMIN_EMAIL=admin@blagh.internal
INITIAL_ADMIN_PASSWORD=ChangeThisPassword!
