APP_NAME=Mock IFS assyst REST API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8081

MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=mock_assyst

ASSYST_API_VERSION=v2
ASSYST_BASE_PATH=/assystREST/v2

MOCK_AUTH_ENABLED=true
MOCK_AUTH_USERNAME=mock_user
MOCK_AUTH_PASSWORD=change_me
MOCK_AUTH_BYPASS=false

SEED_DATA_ENABLED=true
SEED_DATA_COUNT=100

LOG_LEVEL=INFO

FAULT_INJECTION_ENABLED=false
FAULT_INJECTION_ERROR_RATE=0.0
FAULT_INJECTION_DELAY_MS=0

PAGINATION_DEFAULT_SIZE=25
PAGINATION_MAX_SIZE=100

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

SIMILARITY_INDEX_URL=http://localhost:8080
