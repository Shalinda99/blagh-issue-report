# Admin BFF URL — the React app talks to this, NOT the FastAPI backend directly
# Default: http://localhost:4000 (Admin BFF)
VITE_API_URL=http://localhost:4000

# Keycloak realm base URL — used for admin login (password grant)
VITE_KEYCLOAK_BASE=https://<keycloak-host>/auth/realms/<realm>
VITE_KEYCLOAK_CLIENT_ID=app
